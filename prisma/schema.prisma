  /// UTC day, YYYY-MM-DD.
  date           String   @unique
  anchorLedger   Int
  cid            String
  hash           String
  onChainTraceId BigInt?
  mode           String
  /// exact | best_effort
  consistency    String
  report         Json
  createdAt      DateTime @default(now())

  @@index([anchorLedger])
  @@map("transparency_reports")
}

/// Immutable reasoning-registry traces, cached so report counts do not walk
