  marketId    BigInt
  action      String
  traceHash   String
  ipfsCid     String
  publishedAt BigInt
  fetchedAt   DateTime @default(now())

  @@index([agent, action])
  @@map("registry_trace_cache")
}

/// Runs of the reasoning trace auditor
model TraceAuditRun {
  id            String    @id @default(uuid())
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  cursorTraceId BigInt?
  stats         Json?

  @@map("trace_audit_runs")
}

/// Audit findings per on-chain / DB trace
model TraceAudit {
  id              String           @id @default(uuid())
  onChainTraceId  BigInt?
  traceId         String?
  onChainMarketId BigInt?
  agent           String?
  action          String?
  ipfsCid         String?
  onChainHash     String?
  computedHash    String?
  status          TraceAuditStatus
  detail          Json?
  runId           String
  checkedAt       DateTime         @default(now())

  trace ReasoningTrace? @relation(fields: [traceId], references: [id], onDelete: SetNull)

  @@unique([onChainTraceId, runId])
  @@index([status, checkedAt])
  @@index([traceId, checkedAt])
