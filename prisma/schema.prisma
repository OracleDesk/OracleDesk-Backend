/// Rows violating constraints quarantined before repair
model ConstraintQuarantine {
  id        String   @id @default(uuid())
  tableName String   @map("table_name")
  rowId     String   @map("row_id")
  checkName String   @map("check_name")
  row       Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tableName, checkName])
  @@map("constraint_quarantine")
}

/// Lifecycle of a reasoning trace's on-chain publication (#131).
enum TracePublicationStatus {
  AWAITING_PIN
  AWAITING_MARKET
  READY
  SUBMITTED
  CONFIRMED
  FAILED
}

/// Durable queue row: one per trace that should be published to
/// reasoning-registry. Processed by src/jobs/trace-publication.worker.ts.
model TracePublication {
  id               String                 @id @default(uuid())
  traceId          String                 @unique
  action           String
  /// Exact trace document; pinned bytes = canonicalBytes(payload). Null only
  /// for backfilled rows whose trace was already pinned.
  payload          Json?
  status           TracePublicationStatus @default(AWAITING_PIN)
  attempts         Int                    @default(0)
  lastError        String?
  nextAttemptAt    DateTime               @default(now())
  submittedTxHash  String?
  /// Trace id returned by the publish_trace write, used to re-check chain state.
  submittedTraceId BigInt?
  confirmedAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  trace ReasoningTrace @relation(fields: [traceId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("trace_publications")
}

/// Idempotency-Key records for state-changing endpoints (#123). One row per
/// (scope, method, route, key); see src/middlewares/idempotency.middleware.ts.
model IdempotencyKey {
  id              String   @id @default(uuid())
  /// userId, or "anon" for unauthenticated routes
  scope           String
  method          String
  /// Route template, e.g. "/api/v1/trade/copy"
  route           String
  key             String
  /// sha256 of the canonical request (method, route, params, query, body)
  fingerprint     String
  /// IN_PROGRESS | COMPLETED
  status          String
  lockedUntil     DateTime
  responseCode    Int?
  responseBody    Json?
  responseHeaders Json?
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  @@unique([scope, method, route, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}


/// Empirical pairwise market correlations, recomputed on a schedule (#80).
model CorrelationSnapshot {
  id           String   @id @default(uuid())
  computedAt   DateTime @default(now()) @db.Timestamptz(3)
  gridStepSecs Int
  windowDays   Int
  /// [{ a, b, rho, n, method: 'empirical'|'prior', sample, prior, delta }], backend market ids with a < b.
  pairs        Json

  @@index([computedAt])
  @@map("correlation_snapshots")
}

/// One drift finding from the market lifecycle reconciler (#83).
model MarketDriftReport {
  id              String   @id @default(uuid())
  runId           String
  marketId        String
  onChainMarketId BigInt
  driftClass      String
  dbValue         Json
  chainValue      Json
  /// REPAIRED | REPORTED | DEFERRED | SKIPPED_NEWER
  action          String
  observedLedger  Int
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([runId])
  @@index([driftClass, createdAt])
  @@map("market_drift_reports")
}

model ReconcileRun {
  id         String    @id @default(uuid())
  startedAt  DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt DateTime?           @db.Timestamptz(3)
  scanned    Int       @default(0)
  repaired   Int       @default(0)
  reported   Int       @default(0)
  deferred   Int       @default(0)
  rpcCalls   Int       @default(0)
  error      String?

  @@map("reconcile_runs")
}

/// Transaction outbox: every live write persists its signed inner envelope here
/// before submission, and a recovery worker polls and fee-bumps stuck rows
/// (#38). The inner `hash` is the identity; fee-bump envelopes are extra.
/// Outbox state machine (#35): BUILT → SIGNED → SUBMITTED → PENDING →
/// SUCCESS | FAILED | EXPIRED. PENDING means submitted and handed to the
/// recovery worker after the inline wait expired.
enum ChainTxStatus {
  BUILT
  SIGNED
  SUBMITTED
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

/// Transactional outbox (#35, #38): every live write persists its signed
/// inner envelope and hash before submission, a recovery worker resolves
/// non-terminal rows after a crash, and the fee-bump pass wraps stuck rows.
model ChainTransaction {
  id String @id @default(uuid())
  /// Completion-handler key: market.create | trade.buy | trade.sell | trace.publish | <contract>.<method>.
  kind   String
  /// Domain row the write belongs to (Market.id | Trade.id | PositionExit.id | ReasoningTrace.id).
  refId  String?
  contract String?
  method   String?
  args     Json?
  simulated Json?
  /// Transaction source account (agent or leased channel).
  source   String?
  sequence String?
  /// Inner transaction hash (hex). The outbox identity and dedup key.
  hash   String? @unique
  /// Signed inner envelope (base64 XDR), wrapped unchanged by a fee bump.
  envelopeXdr String?
  status      ChainTxStatus @default(BUILT)
  submitLedger Int?
  /// Timebounds (unix seconds); a bump cannot extend maxTime.
  minTime      BigInt?
  maxTime      BigInt?
  /// Ledger the transaction landed in.
  ledger       Int?
  resultXdr    String?
  /// Native return value (printable form) once the write landed.
  returnValue  Json?
  innerFee     String?
  resourceFee  String?
  /// Outer (fee-bump) hashes, in submission order.
  feeBumpHashes String[] @default([])
  /// Array of { hash, fee, xdr, at } for each bump built.
  feeBumpEnvelopes Json?
  /// The hash that actually executed on chain (outer when bumped).
  landedHash   String?
  bumpAttempts Int @default(0)
  attempts     Int @default(0)
  error        String?
  /// When the completion handler ran for a terminal status.
  handledAt    DateTime? @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@index([status])
  @@index([status, updatedAt])
  @@index([landedHash])
  @@index([kind, refId])
  @@index([feeBumpHashes], type: Gin)
  @@map("chain_transactions")
}

/// On-chain fees recorded per transaction (#39).
model ChainFee {
  txHash       String   @id @map("tx_hash")
  opClass      String   @map("op_class")
  inclusionFee BigInt   @map("inclusion_fee")
  resourceFee  BigInt   @map("resource_fee")
  totalFee     BigInt   @map("total_fee")
  feeCharged   BigInt?  @map("fee_charged")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([opClass, createdAt])
  @@map("chain_fees")
}

/// On-chain transaction submissions and lifetime tracking (#42).
model ChainSubmission {
  txHash               String   @id @map("tx_hash")
  opClass              String   @map("op_class")
  minTime              BigInt   @default(0) @map("min_time")
  maxTime              BigInt   @map("max_time")
  authExpirationLedger Int?     @map("auth_expiration_ledger")
  submittedLedger      Int?     @map("submitted_ledger")
  submittedAtCloseTime BigInt?  @map("submitted_at_close_time")
  decision             String   @map("decision")
  rebuildCount         Int      @default(0) @map("rebuild_count")
  attemptId            String?  @map("attempt_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([opClass, createdAt])
  @@index([attemptId])
  @@map("chain_submissions")
}

/// Idempotent market creation attempts (#41).
model MarketCreationAttempt {
  id                        String    @id @default(uuid())
  marketId                  String    @unique @map("market_id")
  market                    Market    @relation(fields: [marketId], references: [id], onDelete: Cascade)
  status                    String    @map("status") // CLAIMED, SUBMITTED, LANDED, UNKNOWN, EXPIRED
  attempts                  Int       @default(0) @map("attempts")
  claimedAt                 DateTime? @map("claimed_at")
  claimLeaseExpiresAt       DateTime? @map("claim_lease_expires_at")
  questionHash              String?   @map("question_hash")
  resolutionHash            String?   @map("resolution_hash")
  preSubmissionMarketCount  BigInt?   @map("pre_submission_market_count")
  postSubmissionMarketCount BigInt?   @map("post_submission_market_count")
  txHash                    String?   @map("tx_hash")
  onChainMarketId           BigInt?   @map("on_chain_market_id")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  @@index([questionHash])
  @@index([status, claimedAt])
  @@map("market_creation_attempts")
}

/// Database-backed admin RBAC (#49). Roles are fixed values seeded on first
/// boot; assignments are the source of truth after that. JWT claims never
/// carry permissions.
model AdminPermission {
  key         String   @id
  description String?
  createdAt   DateTime @default(now())
  roles       AdminRolePermission[]
  @@map("admin_permissions")
}

model AdminRole {
  name        String   @id
  description String?
  createdAt   DateTime @default(now())
  permissions AdminRolePermission[]
  assignments AdminRoleAssignment[]
  @@map("admin_roles")
}

model AdminRolePermission {
  roleName      String
  permissionKey String
  role          AdminRole       @relation(fields: [roleName], references: [name], onDelete: Cascade)
  permission    AdminPermission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)
  createdAt     DateTime        @default(now())

  @@id([roleName, permissionKey])
  @@index([permissionKey])
  @@map("admin_role_permissions")
}

model AdminRoleAssignment {
  id            String   @id @default(uuid())
  walletAddress String   @unique
  roleName      String
  assignedBy    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  role          AdminRole @relation(fields: [roleName], references: [name], onDelete: Restrict)

  @@index([roleName])
  @@map("admin_role_assignments")
}

/// Append-only audit trail for admin actions (#49). The migration adds a
/// trigger that rejects UPDATE and DELETE.
model AdminAuditLog {
  id         String   @id @default(uuid())
  actor      String
  action     String
  target     String?
  roleName   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actor, createdAt])
  @@index([target])
  @@map("admin_audit_logs")
}

/// A server-issued payment intent (#52): the server fixes the amount, memo,
/// recipient and expiry so a pending transaction can be confirmed without the
/// client resubmitting arbitrary details.
model PaymentIntent {
  id              String              @id @default(uuid())
  userId          String
  /// Base account that must be the verified sender.
  walletAddress   String
  status          PaymentIntentStatus @default(OPEN)
  type            SubscriptionType    @default(DAILY_PASS)
  amountRaw       Decimal             @db.Decimal(39, 0)
  currency        SettlementCurrency  @default(USDC)
  recipient       String
  token           String
  memo            String              @unique
  nonce           String              @unique
  txHash          String?             @unique
  subscriptionId  String?             @unique
  paymentEventId  String?             @unique
  overpaymentRaw  Decimal?            @db.Decimal(39, 0)
  underpaymentRaw Decimal?            @db.Decimal(39, 0)
  latePayment     Boolean             @default(false)
  refundRequired  Boolean             @default(false)
  attempts        Int                 @default(0)
  nextAttemptAt   DateTime?
  expiresAt       DateTime
  submittedAt     DateTime?
  confirmedAt     DateTime?
  expiredAt       DateTime?
  failureCode     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([userId, status])
  @@index([status, nextAttemptAt])
  @@index([expiresAt])
  @@map("payment_intents")
}

/// External resolution signer attestations coordinated through the signer API (#91).
/// `status`: PREPARED | SUBMITTED | CONFIRMED | FAILED.
model SignerAttestation {
  id              String   @id @default(uuid())
  marketId        String
  onChainMarketId BigInt
  signer          String
  /// YES | NO
  outcome         String
  status          String
  preparedXdr     String
  /// Hash of the prepared envelope (network-bound); signatures do not change it.
  preparedHash    String
  validUntil      DateTime
  txHash          String?
  ledger          Int?
  error           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([onChainMarketId, signer, outcome])
  @@index([marketId])
  @@map("signer_attestations")
}

/// Independent review of one ResolutionProposed event (#92).
/// `verdict`: PENDING | AGREE | DISAGREE | INSUFFICIENT | ERROR.
model DisputeReview {
  id                 String    @id @default(uuid())
  onChainMarketId    BigInt
  /// chain_events.id of the ResolutionProposed event (or `missed:<market>` for the polling fallback).
  proposalEventId    String    @unique
  proposedOutcome    String
  /// Ledger seconds. Null when the proposal was found by polling and its time is unknown.
  proposedAt         BigInt?
  windowEndsAt       BigInt?
  verdict            String
  independentOutcome String?
  confidence         Float?
  evidence           Json?
  evidenceHash       String?
  acknowledgedBy     String?
  acknowledgedAt     DateTime?
  /// FINALIZED | CANCELLED | null
  resolvedAs         String?
  /// Market category at review time, for calibration slicing (#247).
  category           MarketCategory?
  /// LlmProvenance JSON returned by callLLMStructured (#247).
  evaluatorProvenance Json? @map("evaluator_provenance")
  /// 'primary' | 'news' | 'none' — derived from evidence.items (#247).
  evidenceClass      String? @map("evidence_class")
  /// 'YES' | 'NO' | 'VOID' — set by labelReviews once the market is final (#247).
  finalOutcome       String? @map("final_outcome")
  /// True when proposedOutcome === finalOutcome for FINALIZED reviews (#247).
  proposalCorrect    Boolean? @map("proposal_correct")
  /// Set when this review has been labelled against chain-final ground truth (#247).
  labelledAt         DateTime? @map("labelled_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([verdict])
  @@index([onChainMarketId])
  @@index([labelledAt], map: "dispute_reviews_labelled_at_idx")
  @@map("dispute_reviews")
}

/// One alert sent (or attempted) for a review, deduplicated by `dedupeKey`.
model AlertDelivery {
  id        String    @id @default(uuid())
  /// Dispute review (#92). Null for operational alerts (#226).
  reviewId  String?
  /// Operational incident (#226). Null for dispute alerts.
  incidentId String?
  /// open | escalate | resolve. Dispute rows are all `open`.
  kind      String    @default("open")
  /// INFO | WARN | CRITICAL
  level     String
  sink      String
  /// Dispute: reviewId:level:sink. Incident: inc:<incidentId>:<episode>:<kind>:<severity>:<sink>.
  dedupeKey String    @unique
  /// SENT | FAILED
  status    String
  attempts  Int       @default(0)
  sentAt    DateTime?
  error     String?

  @@index([reviewId])
  @@map("alert_deliveries")
}

/// Operational alert incident (#226): one row per (subjectType, subjectKey),
/// re-opened as a new episode after it resolves. Hysteresis streaks live here
/// so any instance can take over evaluation.
model AlertIncident {
  id             String    @id @default(uuid())
  /// agent_pause | outbox_stuck | outbox_unhandled | cron_failing | reconcile_drift
  subjectType    String
  /// e.g. TRADER:failure_breaker, outbox:trade.buy, cron:trader, drift:status
  subjectKey     String
  /// INFO | WARN | CRITICAL
  severity       String
  /// PENDING (bad, below ALERT_OPEN_AFTER) | OPEN | RESOLVED
  state          String    @default("PENDING")
  /// Incremented on every open; part of the delivery dedupe key. 0 = never opened.
  episode        Int       @default(0)
  summary        String
  detail         Json?
  badStreak      Int       @default(0)
  goodStreak     Int       @default(0)
  openedAt       DateTime? @db.Timestamptz(3)
  resolvedAt     DateTime? @db.Timestamptz(3)
  ackedAt        DateTime? @db.Timestamptz(3)
  ackedBy        String?
  silencedUntil  DateTime? @db.Timestamptz(3)
  lastNotifiedAt DateTime? @db.Timestamptz(3)
  /// Escalations sent in the current episode.
  escalations    Int       @default(0)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([subjectType, subjectKey])
  @@index([state, severity])
  @@map("alert_incidents")
}

/// Cluster-wide cron run record (#226), next to the per-instance in-memory
/// registry, so failure streaks are visible to the alert evaluator.
model CronRunStatus {
  job           String    @id
  lastSuccessAt DateTime? @db.Timestamptz(3)
  lastFailureAt DateTime? @db.Timestamptz(3)
  /// Consecutive failures since the last success, across instances.
  failureStreak Int       @default(0)
  lastError     String?
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  @@map("cron_runs")
}

/// Per-wallet open position for a prediction market outcome (#155).
/// PK matches wallet_positions_pkey from 20261017100002_wallet_pnl.
model WalletPosition {
  wallet          String
  onChainMarketId BigInt
  outcome         String
  shares          Decimal  @default(0) @db.Decimal(39, 0)
  costBasis       Decimal  @default(0) @db.Decimal(39, 0)
  realizedPnl     Decimal  @default(0) @db.Decimal(39, 0)
  boughtCollateral Decimal @default(0) @db.Decimal(39, 0)
  soldCollateral  Decimal  @default(0) @db.Decimal(39, 0)
  feesPaid        Decimal  @default(0) @db.Decimal(39, 0)
  redeemed        Decimal  @default(0) @db.Decimal(39, 0)
  tradeCount      Int      @default(0)
  lastEventId     String   @default("")
  settled         Boolean  @default(false)
  incomplete      Boolean  @default(false)
  /// Plain column default — NOT @updatedAt; the service writes this explicitly.
  updatedAt       DateTime @default(now()) @db.Timestamp(3)

  @@id([wallet, onChainMarketId, outcome], map: "wallet_positions_pkey")
  @@index([onChainMarketId], map: "wallet_positions_onChainMarketId_idx")
  @@map("wallet_positions")
}

/// Daily aggregate stats per wallet and category (#155).
model WalletStatsDaily {
  wallet      String
  day         DateTime @db.Date
  category    String
  volume      Decimal  @default(0) @db.Decimal(39, 0)
  realizedPnl Decimal  @default(0) @db.Decimal(39, 0)
  fees        Decimal  @default(0) @db.Decimal(39, 0)
  trades      Int      @default(0)
  wins        Int      @default(0)
  losses      Int      @default(0)

  @@id([wallet, day, category], map: "wallet_stats_daily_pkey")
  @@index([day], map: "wallet_stats_daily_day_idx")
  @@map("wallet_stats_daily")
}

/// Deduplication log — one row per trade event already applied (#155).
model WalletEventApplied {
  eventId   String   @id(map: "wallet_events_applied_pkey")
  appliedAt DateTime @default(now()) @db.Timestamp(3)

  @@map("wallet_events_applied")
}

/// Markets flagged for PnL recalculation (#155).
model WalletPnlDirtyMarket {
  onChainMarketId BigInt   @id(map: "wallet_pnl_dirty_markets_pkey")
  dirtiedAt       DateTime @default(now()) @db.Timestamp(3)
  reason          String?

  @@map("wallet_pnl_dirty_markets")
}

/// Short-lived exclusive hold on a question that prevents concurrent cycles
/// from creating duplicate markets. Rows are HELD until the market is inserted
/// (then COMMITTED), or released on skip/abort/failure.
model MarketReservation {
  id              String    @id @default(uuid())
  cycleId         String
  question        String
  /// sha256(exactKey(question, expiryDay)) — partial unique index enforced in SQL
  questionKey     String
  category        MarketCategory
  expiryTimestamp DateTime  @db.Timestamptz(3)
  embeddingModel  String?
  /// JSON array of numbers; compared in-process, never indexed
  embeddingVector Json?
  /// HELD | COMMITTED | RELEASED
  status          String
  marketId        String?   @unique
  leaseUntil      DateTime  @db.Timestamptz(3)
  createdAt       DateTime  @default(now())

  @@index([status, leaseUntil])
  @@map("market_reservations")
}

model PortfolioRiskSnapshot {
  id                     String   @id @default(uuid())
  computedAt             DateTime @default(now()) @db.Timestamptz(3)
  correlationSnapshotId  String?
  inputsHash             String
  paths                  Int
  metrics                Json
  flags                  Json
  durationMs             Int

  @@index([computedAt])
  @@map("portfolio_risk_snapshots")
}

/// Tracks premium session devices per user to enforce the concurrent-device cap (#288).
model PremiumDevice {
  id            String    @id @default(uuid())
  userId        String
  /// sha-256(deviceKey) so the raw secret never touches the DB
  deviceKeyHash String
  label         String    @default("Device")
  /// Session ids (JWT `sid`) that first registered and last used the device.
  firstSid      String
  lastSid       String
  /// Salted hash of the client IP prefix (hashClientIp); never the raw IP.
  ipPrefixHash  String?
  lastSeenAt    DateTime  @default(now()) @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  /// Set when the device is evicted (LRU) or revoked; a fresher login re-admits it.
  revokedAt     DateTime? @db.Timestamptz(3)
  /// EVICTED_LRU | USER_REVOKED | ADMIN @db.Timestamptz(3)
  revokeReason  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceKeyHash])
  @@index([userId, lastSeenAt])
  @@map("premium_devices")
}

/// Per-user, per-day premium usage budget (#288).
model PremiumUsageDaily {
  id                 String   @id @default(uuid())
  userId             String
  day                DateTime @db.Date
  premiumReads       Int      @default(0)
  keyReleases        Int      @default(0)
  devicesEvicted     Int      @default(0)
  distinctIpPrefixes Int      @default(0)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([distinctIpPrefixes])
  @@map("premium_usage_daily")
}

/// Fitted per-category recalibration maps (#244). One active row per
/// (agentType, category); superseded versions stay for audit. `id` is the
/// map's content hash, so a refit from the same inputs reproduces it.
model RecalibrationMapRow {
  id         String   @id
  agentType  String
  category   String
  version    Int
  params     Json
  fittedFrom Json
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([agentType, category, version])
  @@index([agentType, category, active])
  @@map("recalibration_maps")
}

/// Per-signer single-use SEP-7 signing request (#270). Raw callback tokens are
/// never persisted — only their SHA-256 hex digest (`tokenHash`).
model Sep7Request {
  id          String    @id @default(uuid())
  operationId String
  signer      String
  tokenHash   String    @unique
  status      String    @default("ISSUED")
  uri         String
  expiresAt   DateTime
  usedAt      DateTime?
  rejectCode  String?
  createdAt   DateTime  @default(now())

  @@unique([operationId, signer])
  @@map("sep7_requests")
}

enum IpfsPinState {
  PENDING
  PINNING
  PINNED
  MISSING
  FAILED
}

/// Per-CID, per-provider replication state for anchored IPFS documents (#271).
model IpfsPin {
  cid           String
  provider      String
  state         IpfsPinState @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?
  lastCheckedAt DateTime?
  pinnedAt      DateTime?

  @@id([cid, provider])
  @@map("ipfs_pins")
}

/// Learned signal source/publisher weights (#223). DRAFT → APPROVED → ACTIVE →
/// RETIRED; at most one ACTIVE row (raw-SQL partial unique index
/// source_weight_sets_active_key). Written by `npm run weights:estimate -- --save`.
model SourceWeightSet {
  id          String    @id @default(uuid())
  version     Int       @unique
  /// DRAFT | APPROVED | ACTIVE | RETIRED
  status      String    @default("DRAFT")
  /// { "source:NEWSAPI": 0.64, "publisher:reuters.com": 0.81 }
  weights     Json
  /// { key: { lower, upper, nEff, nMarkets, insufficient, ... } }
  intervals   Json
  /// { priorSd, window, cutoff, inputDigest, heldOutDeltaLogLoss, regression, ... }
  method      Json
  parentId    String?
  createdBy   String
  approvedBy  String?
  activatedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@map("source_weight_sets")
}

/// One money-audit run (#222): invariants over trades, positions, exits and
/// outbox rows, read from one REPEATABLE READ snapshot taken at snapshotAt.
model MoneyAuditRun {
  id             String    @id @default(uuid())
  startedAt      DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt     DateTime? @db.Timestamptz(3)
  snapshotAt     DateTime  @db.Timestamptz(3)
  /// Highest ledger a chain read of this run observed.
  observedLedger Int?
  checked        Int       @default(0)
  findings       Int       @default(0)
  repaired       Int       @default(0)
  rpcCalls       Int       @default(0)
  error          String?

  @@map("money_audit_runs")
}

/// One invariant violation seen by a money-audit run (#222).
model MoneyAuditFinding {
  id              String    @id @default(uuid())
  runId           String
  /// e.g. TRADE_EXECUTED_WITHOUT_OUTBOX
  invariant       String
  /// CRITICAL | HIGH | MEDIUM | INFO
  severity        String
  /// trade | position | exit | outbox | market_side | trace
  subjectType     String
  subjectId       String
  evidence        Json
  suggestedRepair String?
  /// REPORTED | REPAIRED | SKIPPED_IN_FLIGHT | DEFERRED | ACKED
  action          String
  /// sha256(invariant|subjectId|evidence-core): carries a finding across runs.
  fingerprint     String
  firstSeenRunId  String
  ackedBy         String?
  ackedAt         DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  @@index([runId])
  @@index([invariant, createdAt])
  @@index([fingerprint])
  @@map("money_audit_findings")
}

/// Versioned agent risk parameters (#274).
model RiskParamSet {
  id          String    @id @default(uuid())
  scope       String
  version     Int
  params      Json
  paramsHash  String
  status      String    @default("PROPOSED")
  reason      String
  proposedBy  String
  approvedBy  String?
  activatedBy String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  approvedAt  DateTime? @db.Timestamptz(3)
  activatedAt DateTime? @db.Timestamptz(3)

  @@unique([scope, version])
  @@index([scope, status])
  @@map("risk_param_sets")
}

model RiskParamActive {
  scope       String   @id
  setId       String
  version     Int
  activatedAt DateTime @db.Timestamptz(3)

  @@map("risk_param_active")
}
