{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.oracledesk.io/api/v1/schemas/question/v2.json",
  "title": "OracleDesk Question Document v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "question",
    "category",
    "contractCategory",
    "closeTime",
    "resolutionSource",
    "resolutionHash",
    "backendMarketId",
    "resolution"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "FED",
        "ECB",
        "MACRO",
        "GEOPOLITICAL",
        "ELECTION",
        "POLITICS",
        "CRYPTO",
        "SPORTS",
        "ENTERTAINMENT"
      ]
    },
    "contractCategory": {
      "type": "string",
      "enum": [
        "Macro",
        "Geopolitics",
        "Crypto",
        "Sports",
        "Culture",
        "Other"
      ]
    },
    "closeTime": {
      "type": "integer"
    },
    "resolutionSource": {
      "type": [
        "string",
        "null"
      ]
    },
    "resolutionHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "backendMarketId": {
      "type": "string",
      "format": "uuid"
    },
    "priceResolution": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind",
        "reflector",
        "asset",
        "assetKind",
        "threshold",
        "direction",
        "maxStaleness"
      ],
      "properties": {
        "kind": {
          "const": "price"
        },
        "reflector": {
          "type": "string"
        },
        "asset": {
          "type": "string"
        },
        "assetKind": {
          "type": "string"
        },
        "threshold": {
          "type": [
            "number",
            "string"
          ]
        },
        "direction": {
          "type": "string"
        },
        "maxStaleness": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
